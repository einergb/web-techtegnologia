# API origin; local: http://localhost:8080; deployed API: https://tiendaapi.codeconheiner.com; Docker stack: http://tienda-api:8080.
API_BASE_URL=http://localhost:8080

# Public store URL. Used for metadata, secure session cookies and Origin checks.
SITE_URL=http://localhost:3000

# Comma-separated HTTPS image hostnames allowed by Next image configuration.
IMAGE_HOSTS=img.codeconheiner.com

# Maximum request body forwarded by the API proxy (8 MiB by default).
PROXY_MAX_BODY_BYTES=8388608
